# ============================================================
# Pantale — variáveis de ambiente
# ------------------------------------------------------------
# Copie para .env e preencha. NUNCA comite o .env preenchido:
# quem tiver o Access Token cobra no seu nome.
#
# Em produção (Render, Railway, Fly, VPS…) prefira cadastrar
# estas variáveis no painel do serviço em vez de subir arquivo.
# ============================================================

# --- Endereço público do site -------------------------------
# Usado no robots.txt, no sitemap.xml e nas URLs de retorno e de
# webhook do Mercado Pago. Sem barra no final.
SITE_URL=https://www.pantale.com.br

# --- Mercado Pago -------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel
#
# 1) Suas integrações > sua aplicação > Credenciais
#    - Credenciais de TESTE: token começa com TEST-  (não cobra de verdade)
#    - Credenciais de PRODUÇÃO: token começa com APP_USR-  (cobra de verdade)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# 2) Na MESMA tela de credenciais, seção Webhooks:
#    cadastre a URL   https://www.pantale.com.br/api/mercadopago/webhook
#    marque o evento  "Pagamentos"
#    e copie a "Assinatura secreta" que aparece ali.
#
# Sem este segredo o servidor RECUSA todas as notificações — é ele
# que prova que a notificação veio do Mercado Pago e não de alguém
# dizendo "pedido 42 pago" para levar mercadoria de graça.
MP_WEBHOOK_SECRET=

# --- Segurança ----------------------------------------------
# Chave de assinatura dos tokens de login. Em produção defina um
# valor forte e secreto; sem isso o servidor gera um em .jwt-secret,
# e todo mundo é deslogado se esse arquivo se perder.
JWT_SECRET=

# Origens liberadas no CORS, separadas por vírgula. Só é necessário
# se o site for servido de um domínio diferente do da API.
ALLOWED_ORIGINS=

# --- E-mail de pedidos (alternativa ao mail-config.json) ----
SMTP_USER=
SMTP_PASS=
MAIL_TO=
